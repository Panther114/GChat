{
  "name": "Gchat",
  "version": "1.4.6",
  "description": "End-to-end encrypted group chat app",
  "author": "Gchat",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:web": "cross-env NODE_ENV=development GCHAT_LOCAL_DEBUG=1 PORT=4400 DB_PATH=.gchat-local/Gchat.db node scripts/dev-web.js",
    "dev:web:e2e": "cross-env NODE_ENV=development GCHAT_LOCAL_DEBUG=1 PORT=4401 DB_PATH=.gchat-local/e2e/Gchat.db node scripts/dev-web.js",
    "build:web": "node scripts/build-web.js",
    "migrate:group-invite-codes": "node scripts/migrate-group-invite-codes.js",
    "migrate:sync-v2": "node scripts/migrate-sync-v2.js",
    "reconcile:channel-summaries": "node scripts/reconcile-channel-summaries.js",
    "purge:pre-escrow-groups": "node scripts/purge-pre-escrow-groups.js",
    "lint": "eslint server.js src/server src-tauri/src/bridge.js src-desktop-win/src/bridge.js electron scripts test",
    "test": "node --test test/security.test.js test/web-crypto.test.js test/ai-agent.test.js test/sync-v2.test.js test/integration.test.js test/electron-runtime.test.js test/electron-packaging.test.js test/desktop-packaging.test.js",
    "test:unit": "node --test test/security.test.js test/web-crypto.test.js test/electron-runtime.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:cli": "npm --prefix cli test",
    "test:e2e": "playwright test",
    "gchat": "node cli/bin/gchat.js",
    "verify": "npm run lint && npm run build:web && npm test",
    "desktop": "cargo run --manifest-path src-desktop-win/Cargo.toml",
    "desktop:dev": "cargo run --manifest-path src-desktop-win/Cargo.toml",
    "desktop:mac": "tauri dev",
    "test:desktop": "cargo test --manifest-path src-desktop-win/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
    "build:win": "node scripts/build-win-thin.js",
    "build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:linux": "tauri build --bundles appimage,deb",
    "build:win:tauri": "tauri build --bundles nsis",
    "build:win:electron": "node scripts/build-electron-main.js && node scripts/ensure-electron-builder.js && electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "12.8.0",
    "compression": "^1.8.1",
    "express": "^4.22.2",
    "express-session": "^1.17.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.11.4",
    "cross-env": "^7.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4"
  },
  "build": {
    "appId": "com.Gchat.app",
    "productName": "Gchat",
    "copyright": "Copyright © 2024-2026 Gchat",
    "asar": true,
    "compression": "maximum",
    "afterPack": "scripts/after-pack.js",
    "electronLanguages": [
      "en-US"
    ],
    "extraMetadata": {
      "main": "electron/main.bundle.cjs"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/main.bundle.cjs",
      "electron/updater.bundle.cjs",
      "electron/preload.js",
      "electron/offline.html",
      "electron/offline.js",
      "electron/desktop.css",
      "public/gchat_icon.png",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Gchat-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gchat",
      "uninstallDisplayName": "Gchat ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "artifactName": "Gchat-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "public/gchat_icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/gchat_icon.png",
      "maintainer": "Gchat",
      "category": "Network"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "npmRebuild": false
  }
}
