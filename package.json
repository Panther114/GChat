{
  "name": "Gchat",
  "version": "1.3.5",
  "description": "End-to-end encrypted group chat app",
  "author": "Gchat",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:web": "cross-env NODE_ENV=development GCHAT_LOCAL_DEBUG=1 PORT=4400 DB_PATH=.gchat-local/Gchat.db node scripts/dev-web.js",
    "dev:web:e2e": "cross-env NODE_ENV=development GCHAT_LOCAL_DEBUG=1 PORT=4401 DB_PATH=.gchat-local/e2e/Gchat.db node scripts/dev-web.js",
    "build:web": "node scripts/build-web.js",
    "migrate:group-invite-codes": "node scripts/migrate-group-invite-codes.js",
    "purge:pre-escrow-groups": "node scripts/purge-pre-escrow-groups.js",
    "lint": "eslint server.js src/server src-tauri/src/bridge.js scripts test",
    "test": "node --test test/security.test.js test/web-crypto.test.js test/integration.test.js test/desktop-packaging.test.js",
    "test:unit": "node --test test/security.test.js test/web-crypto.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run build:web && npm test",
    "desktop": "tauri dev",
    "desktop:dev": "tauri dev",
    "test:desktop": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:win": "tauri build --bundles nsis",
    "build:mac": "tauri build --target universal-apple-darwin --bundles dmg",
    "build:linux": "tauri build --bundles appimage,deb"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "12.8.0",
    "express": "^4.22.2",
    "express-session": "^1.17.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.11.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4"
  }
}
