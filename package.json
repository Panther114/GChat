{
  "name": "Gchat",
  "version": "1.3.1",
  "description": "End-to-end encrypted group chat app",
  "author": "Gchat",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:web": "cross-env NODE_ENV=development GCHAT_LOCAL_DEBUG=1 PORT=4400 DB_PATH=.gchat-local/Gchat.db node scripts/dev-web.js",
    "build:web": "node scripts/build-web.js",
    "lint": "eslint server.js src/server scripts test",
    "test": "node --test test/security.test.js test/web-crypto.test.js test/integration.test.js",
    "test:unit": "node --test test/security.test.js test/web-crypto.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run build:web && npm test",
    "migrate:increment-a": "node scripts/migrate-increment-a.js",
    "electron": "electron electron/main.js",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "prebuild:win": "node scripts/build-electron-main.js && node scripts/ensure-electron-builder.js",
    "prebuild:mac": "node scripts/build-electron-main.js && node scripts/ensure-electron-builder.js",
    "prebuild:linux": "node scripts/build-electron-main.js && node scripts/ensure-electron-builder.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "12.8.0",
    "electron-updater": "^6.3.0",
    "express": "^4.22.2",
    "express-session": "^1.17.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^25.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4"
  },
  "build": {
    "appId": "com.Gchat.app",
    "productName": "Gchat",
    "copyright": "Copyright © 2024-2026 Gchat",
    "asar": true,
    "compression": "maximum",
    "extraMetadata": {
      "main": "electron/main.bundle.cjs"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/main.bundle.cjs",
      "electron/preload.js",
      "electron/offline.html",
      "electron/offline.js",
      "electron/desktop.css",
      "public/gchat_icon.png",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Gchat-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gchat",
      "uninstallDisplayName": "Gchat ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/gchat_icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/gchat_icon.png",
      "maintainer": "Gchat",
      "category": "Network"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "npmRebuild": false
  }
}
